//
//  Project.xcconfig
//  OshiCon
//
//  プロジェクト共通のビルド設定。
//  テンプレートから新規リポジトリを作成したら、まずこのファイルの値を書き換える。
//  （pbxproj 側にはこれらの値を直接書かず、ここだけを編集する）
//

// Apple Developer Program の Team ID
DEVELOPMENT_TEAM = XU74X3434S

// アプリ本体の Bundle Identifier。
// テストターゲットは $(APP_BUNDLE_IDENTIFIER).Tests / .UITests として派生させる
APP_BUNDLE_IDENTIFIER = jp.shilokuma.OshiCon

// アプリとウィジェットでデータ（SwiftData のストアと推しの写真）を共有する App Group。
// Entitlements と Info.plist（AppGroupIdentifier）はこの値を参照する
APP_GROUP_IDENTIFIER = group.$(APP_BUNDLE_IDENTIFIER)

// バージョン（CFBundleShortVersionString / CFBundleVersion）
MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 1

// 最低サポート OS
IPHONEOS_DEPLOYMENT_TARGET = 17.0
