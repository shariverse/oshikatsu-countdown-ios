#include "Project.xcconfig"

// テーマ案の Preview 用の書体とライセンス文（OshiCon/Preview Content/Fonts/）を出荷物に入れない。
// フォルダ同期グループのリソースは DEVELOPMENT_ASSET_PATHS では Archive から外れないので、名前で外す。
// 書体を足したらここにも足す（PreviewFontsTests が確かめる）
EXCLUDED_SOURCE_FILE_NAMES = KiwiMaru-* ZenMaruGothic-* ZenKakuGothicNew-Light.ttf KaiseiDecol-* MochiyPopOne-*
