<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widget Extension のプライバシーマニフェスト。アプリ（OshiCon/PrivacyInfo.xcprivacy）とは別のバンドルなので、別に置く -->
	<!-- トラッキングしない -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- データを収集しない -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- 理由の申告が要る API は、アプリと共有する App Group の UserDefaults(suiteName:)（Plus が使えるかの判定の結果を読む）だけ -->
	<!-- ほかは App Group のコンテナの SwiftData のストアと写真を読むだけ。ファイルのタイムスタンプなどを使うならその理由を足す -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- 1C8F.1: 同じ App Group のアプリ・拡張とだけ共有する読み書き -->
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
