    "推しごとに選べます" : {
      "comment" : "着せ替えの画面の「背景」のタブ。背景の写真の切り替えの下に添える（写真は共通と推しごとに選べる）",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can pick one for each oshi" } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "推しごとに選べます" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可以为每位本命分别选择" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可以為每位我推分別選擇" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "최애마다 고를 수 있어요" } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vous pouvez en choisir une par oshi" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Für jedes Oshi einzeln wählbar" } },
