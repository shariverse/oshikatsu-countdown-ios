        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有 Plus 也可以選擇照片試穿並儲存。開通 Plus 後，會顯示在主頁和行程詳情中。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Plus가 없어도 사진을 골라 미리 입혀 보고 저장해 둘 수 있어요. Plus를 이용하면 홈과 일정 상세에 나타나요." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sans Plus, vous pouvez déjà choisir une photo, l'essayer et l'enregistrer. Avec Plus, elle s'affiche sur l'accueil et le détail des événements." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auch ohne Plus kannst du ein Foto wählen, ausprobieren und speichern. Mit Plus erscheint es auf Start und in den Termindetails." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin Plus puedes elegir una foto, probarla y guardarla. Con Plus, aparece en el inicio y en el detalle de los eventos." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mesmo sem o Plus, você pode escolher uma foto, experimentar e salvar. Com o Plus, ela aparece no início e nos detalhes dos eventos." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Anche senza Plus puoi scegliere una foto, provarla e salvarla. Con Plus, appare nella Home e nei dettagli degli eventi." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "แม้ไม่มี Plus ก็เลือกรูป ลองแต่ง และบันทึกไว้ได้ เมื่อใช้ Plus รูปจะแสดงในหน้าหลักและรายละเอียดกิจกรรม" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tanpa Plus pun kamu bisa memilih foto, mencobanya, dan menyimpannya. Dengan Plus, foto tampil di Beranda dan detail acara." } }
      }
    },
    "Plus で使う" : {
