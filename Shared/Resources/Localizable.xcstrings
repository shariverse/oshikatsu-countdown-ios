        "ja" : { "stringUnit" : { "state" : "translated", "value" : "サブスクリプション中に買い切りを購入しても、サブスクリプションは自動で止まりません。購入後に、ご自身で解約してください。" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "订阅期间购买一次性购买项目，订阅不会自动停止。购买后请自行取消订阅。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "訂閱期間購買一次性購買項目，訂閱不會自動停止。購買後請自行取消訂閱。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "구독 중에 한 번 구매를 해도 구독은 자동으로 해지되지 않아요. 구매 후 직접 구독을 해지해 주세요." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "L'achat unique n'annule pas automatiquement votre abonnement. Pensez à le résilier vous-même après l'achat." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Der Einmalkauf beendet dein Abo nicht automatisch. Bitte kündige es nach dem Kauf selbst." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El pago único no cancela tu suscripción automáticamente. Cancélala tú mismo después de comprar." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A compra única não cancela sua assinatura automaticamente. Cancele-a você mesmo depois da compra." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "L'acquisto singolo non annulla automaticamente l'abbonamento. Annullalo tu dopo l'acquisto." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "การซื้อครั้งเดียวระหว่างที่สมัครสมาชิกอยู่จะไม่ยกเลิกการสมัครสมาชิกให้อัตโนมัติ โปรดยกเลิกด้วยตนเองหลังซื้อ" } },
