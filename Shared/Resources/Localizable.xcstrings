    "ホーム画面のアイコンを、推し色の 12 色から選べます。ライトとダークの外観のどちらにも合わせます" : {
      "comment" : "着せ替えの画面。アイコンのタブの説明",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose your Home Screen icon from the 12 member colors. It suits both light and dark appearance." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ホーム画面のアイコンを、推し色の 12 色から選べます。ライトとダークの外観のどちらにも合わせます" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可从 12 种应援色中选择主屏幕上的图标。浅色和深色外观都适用。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可從 12 種應援色中選擇主畫面上的圖示。淺色和深色外觀都適用。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "홈 화면의 아이콘을 멤버 컬러 12색 중에서 고를 수 있어요. 라이트와 다크 모드 모두에 어울려요." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez l'icône de l'écran d'accueil parmi les 12 couleurs de membre. Elle s'adapte aux apparences claire et sombre." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wähle das Symbol auf dem Home-Bildschirm aus den 12 Mitgliedsfarben. Es passt zum hellen und zum dunklen Erscheinungsbild." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige el icono de la pantalla de inicio entre los 12 colores del miembro. Se adapta a los aspectos claro y oscuro." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Escolha o ícone da tela de início entre as 12 cores do membro. Ele combina com a aparência clara e a escura." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Scegli l'icona della schermata Home tra i 12 colori del membro. Si adatta all'aspetto chiaro e a quello scuro." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "เลือกไอคอนบนหน้าจอโฮมได้จากสีประจำตัว 12 สี ใช้ได้ทั้งโหมดสว่างและโหมดมืด" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Pilih ikon di Layar Utama dari 12 warna member. Cocok untuk tampilan terang maupun gelap." } }
      }
