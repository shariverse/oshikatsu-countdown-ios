    "選んだ予定まであと何日かを推し色で表示します" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows how many days are left until the event you choose, in your oshi's color."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ予定まであと何日かを推し色で表示します"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用应援色显示距离所选日程还有几天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用應援色顯示距離所選行程還有幾天。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택한 일정까지 며칠 남았는지 멤버 컬러로 표시합니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche le nombre de jours restants avant l'événement choisi, aux couleurs de ton oshi."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeigt in der Farbe deines Oshi, wie viele Tage es noch bis zum gewählten Termin sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra cuántos días faltan para el evento elegido, con el color de tu oshi."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quantos dias faltam para o evento escolhido, na cor do seu oshi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra quanti giorni mancano all'evento scelto, con il colore del tuo oshi."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แสดงจำนวนวันที่เหลือจนถึงกิจกรรมที่เลือกด้วยสีประจำตัวของโอชิ"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menampilkan berapa hari lagi menuju acara pilihanmu, dengan warna oshi kamu."
          }
        }
      }
    },
