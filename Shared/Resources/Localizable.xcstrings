    "誕生日や記念日は、過ぎたら翌年の同じ日を数えます" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For birthdays and anniversaries. Once the day passes, it counts down to the same day next year."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "誕生日や記念日は、過ぎたら翌年の同じ日を数えます"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于生日和纪念日。过了当天后，会倒数到明年的同一天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "適用於生日和紀念日。過了當天後，會倒數到明年的同一天。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생일이나 기념일은 지나면 다음 해의 같은 날까지 셉니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour les anniversaires : une fois le jour passé, le compte reprend jusqu'au même jour l'année suivante."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Geburts- und Jahrestage: Ist der Tag vorbei, wird bis zum selben Tag im nächsten Jahr gezählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para cumpleaños y aniversarios: cuando pasa el día, cuenta hasta el mismo día del año siguiente."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para aniversários e datas especiais: quando o dia passa, conta até o mesmo dia do ano seguinte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per compleanni e anniversari: passato il giorno, conta fino allo stesso giorno dell'anno successivo."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "สำหรับวันเกิดหรือวันครบรอบ เมื่อผ่านไปแล้วจะนับถึงวันเดียวกันของปีถัดไป"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk ulang tahun dan hari jadi. Setelah lewat, hitungan berlanjut ke tanggal yang sama tahun depan."
          }
        }
      }
    },
