    "選んだ色が、ホーム画面のアイコンになります" : {
      "comment" : "着せ替えの画面。アイコンのタブの Plus の案内（Plus の人）",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The color you choose becomes your Home Screen icon." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "選んだ色が、ホーム画面のアイコンになります" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选颜色会成为主屏幕上的图标。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "所選顏色會成為主畫面上的圖示。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "고른 색이 홈 화면의 아이콘이 돼요." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "La couleur choisie devient l'icône de l'écran d'accueil." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Die gewählte Farbe wird zum Symbol auf dem Home-Bildschirm." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "El color elegido será el icono de la pantalla de inicio." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "A cor escolhida vira o ícone da tela de início." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Il colore scelto diventa l'icona della schermata Home." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "สีที่เลือกจะเป็นไอคอนบนหน้าจอโฮม" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Warna pilihanmu menjadi ikon di Layar Utama." } }
      }
    },
    "Plus でなくても、色を選んで見本で試せます。Plus にすると、ホーム画面のアイコンが替わります" : {
      "comment" : "着せ替えの画面。アイコンのタブの Plus の案内（Plus でない人）",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "You can choose a color and try it in the preview without Plus. With Plus, your Home Screen icon changes." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "Plus でなくても、色を選んで見本で試せます。Plus にすると、ホーム画面のアイコンが替わります" } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "没有 Plus 也可以选择颜色并在预览中试看。开通 Plus 后，主屏幕上的图标会随之更换。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "沒有 Plus 也可以選擇顏色並在預覽中試看。開通 Plus 後，主畫面上的圖示會隨之更換。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "Plus가 없어도 색을 골라 미리보기에서 확인할 수 있어요. Plus를 이용하면 홈 화면의 아이콘이 바뀌어요." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sans Plus, vous pouvez déjà choisir une couleur et l'essayer dans l'aperçu. Avec Plus, l'icône de l'écran d'accueil change." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Auch ohne Plus kannst du eine Farbe wählen und in der Vorschau ausprobieren. Mit Plus ändert sich das Symbol auf dem Home-Bildschirm." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin Plus puedes elegir un color y probarlo en la vista previa. Con Plus, cambia el icono de la pantalla de inicio." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Mesmo sem o Plus, você pode escolher uma cor e experimentar na prévia. Com o Plus, o ícone da tela de início muda." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Anche senza Plus puoi scegliere un colore e provarlo nell'anteprima. Con Plus, l'icona della schermata Home cambia." } },
        "th" : { "stringUnit" : { "state" : "translated", "value" : "แม้ไม่มี Plus ก็เลือกสีและลองดูในตัวอย่างได้ เมื่อใช้ Plus ไอคอนบนหน้าจอโฮมจะเปลี่ยนไป" } },
        "id" : { "stringUnit" : { "state" : "translated", "value" : "Tanpa Plus pun kamu bisa memilih warna dan mencobanya di pratinjau. Dengan Plus, ikon di Layar Utama ikut berganti." } }
      }
    }
