    "名前と推し色を登録すると、予定やカウントダウンが推し色になります。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a name and member color, and your events and countdowns will show in that color."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前と推し色を登録すると、予定やカウントダウンが推し色になります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登记名字和应援色后，日程和倒数都会变成应援色。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登錄名字和應援色後，行程和倒數都會變成應援色。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름과 멤버 컬러를 등록하면 일정과 카운트다운이 멤버 컬러로 표시됩니다."
          }
        },
        "fr" : {
