    "ライブ・誕生日・発売日など、楽しみな日を 1 つ入れてみてね。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try adding one day you're looking forward to, like a concert, a birthday, or a release day."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ・誕生日・発売日など、楽しみな日を 1 つ入れてみてね。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "试着添加一个你期待的日子吧，比如演出、生日或发售日。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "試著新增一個你期待的日子吧，例如演出、生日或發售日。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공연·생일·발매일 등 기다려지는 날을 하나 넣어 보세요."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute un jour que tu attends avec impatience : un concert, un anniversaire, une sortie…"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag einen Tag ein, auf den du dich freust – ein Konzert, einen Geburtstag oder einen Release."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un día que estés esperando, como un concierto, un cumpleaños o un lanzamiento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um dia que você está esperando, como um show, um aniversário ou um lançamento."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi un giorno che non vedi l'ora che arrivi, come un concerto, un compleanno o un'uscita."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลองเพิ่มวันที่คุณรอคอยสักวัน เช่น คอนเสิร์ต วันเกิด หรือวันวางขาย"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coba tambahkan satu hari yang kamu nantikan, seperti konser, ulang tahun, atau tanggal rilis."
          }
        }
      }
    },
    "ライブ・誕生日・発売日を登録すると、その日まであと何日かを数えます。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add concerts, birthdays, and release days to see how many days are left until each one."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ライブ・誕生日・発売日を登録すると、その日まであと何日かを数えます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登记演出、生日或发售日后，就会倒数到那一天还有几天。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "登錄演出、生日或發售日後，就會倒數到那一天還有幾天。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공연·생일·발매일을 등록하면 그날까지 며칠 남았는지 셉니다."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des concerts, anniversaires ou dates de sortie pour voir combien de jours il reste."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trag Konzerte, Geburtstage und Releases ein und sieh, wie viele Tage es noch sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade conciertos, cumpleaños y lanzamientos para ver cuántos días faltan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione shows, aniversários e lançamentos para ver quantos dias faltam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi concerti, compleanni e uscite per vedere quanti giorni mancano."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เพิ่มคอนเสิร์ต วันเกิด หรือวันวางขาย แล้วแอปจะนับว่าเหลืออีกกี่วัน"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tambahkan konser, ulang tahun, dan tanggal rilis untuk melihat berapa hari lagi."
          }
        }
      }
    },
